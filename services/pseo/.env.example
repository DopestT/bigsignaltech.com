# Core service
DATABASE_URL=postgres://user:password@host:5432/bigsignal
INTERNAL_API_KEY=replace-with-a-long-random-secret
PUBLIC_SITE_URL=https://bigsignaltech.com
PSEO_PATH_PREFIX=/tools
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# DataForSEO - keep real credentials out of git
DATAFORSEO_LOGIN=replace-with-dataforseo-login
DATAFORSEO_PASSWORD=replace-with-dataforseo-password

# OpenAI content generation - keep real key out of git
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-5.6-terra

# Edge/static publisher. Must accept the BigSignal upsert_batch payload.
EDGE_INGEST_URL=https://publisher.internal.example/api/pseo/upsert
EDGE_INGEST_API_KEY=replace-with-edge-ingest-secret

# IndexNow. The key file must be publicly reachable before dispatch.
INDEXNOW_HOST=bigsignaltech.com
INDEXNOW_KEY=replace-with-indexnow-key
INDEXNOW_KEY_LOCATION=https://bigsignaltech.com/replace-with-indexnow-key.txt
